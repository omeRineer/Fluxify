{
  "AllowOrigins": [
    "http://localhost:5500",
    "http://localhost:7485"
  ],

  "MongoDbOptions": {
    "ConnectionString": "mongodb://fluxify.db.mongodb/",
    "DataBase": "Fluxify"
  },


  "RabbitMqOptions": {
    "Host": "fluxify.rabbitmq",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "fluxify",
    "Password": "fluxify",
    "Exchanges": [
      {
        "Name": "notification-topic",
        "Type": "topic",
        "Durable": true,
        "AutoDelete": false
      }
    ],
    "Queues": [
      {
        "Name": "notification-socket",
        "Bindings": {
          "notification.created": "notification-topic",
          "notification.socket": "notification-topic"
        },
        "Durable": true,
        "Exclusive": false,
        "AutoDelete": false,
        "EnableRq": true
      },
      {
        "Name": "notification-firebase",
        "Bindings": {
          "notification.created": "notification-topic",
          "notification.firebase": "notification-topic"
        },
        "Durable": true,
        "Exclusive": false,
        "AutoDelete": false,
        "EnableRq": false
      }
    ]
  }
}
