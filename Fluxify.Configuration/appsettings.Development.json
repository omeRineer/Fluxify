{
  "MongoDbOptions": {
    "ConnectionString": "mongodb://localhost:27017/",
    "DataBase": "Fluxify"
  },

  "NotificationOptions": {
    "Levels": [ "info", "error", "success", "warning" ],
    "ContentTypes": [ "html", "text" ]
  },

  "RabbitMqOptions": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "gamestore",
    "Password": "gamestore",
    "Exchanges": [
      {
        "Name": "notification-topic",
        "Type": "topic",
        "Durable": true,
        "AutoDelete": false
      }
    ],
    "Queues": [
      {
        "Name": "notification-socket",
        "Bindings": {
          "notification.created": "notification-topic",
          "notification.socket": "notification-topic"
        },
        "Durable": true,
        "Exclusive": false,
        "AutoDelete": false,
        "EnableRq": true
      },
      {
        "Name": "notification-firebase",
        "Bindings": {
          "notification.created": "notification-topic",
          "notification.firebase": "notification-topic"
        },
        "Durable": true,
        "Exclusive": false,
        "AutoDelete": false,
        "EnableRq": false
      }
    ]
  }
}
